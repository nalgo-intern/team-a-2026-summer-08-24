# Kaggle APIの認証情報（現在の推奨形式）
# https://www.kaggle.com/settings/api の「Generate New Token」で取得
KAGGLE_API_TOKEN=your_kaggle_api_token

# 旧形式を使う場合はこちら（KAGGLE_API_TOKENとはどちらか一方）
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# 任意設定
# DEVICE=cpu
# CNN_MODEL_PATH=../../odaira_keiji/cnn_test/model.keras
